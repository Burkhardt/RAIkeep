@startuml RAIkeep-Package-Dependencies
title RAIkeep Package Dependencies

top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam DiagramFontName "Casual"
skinparam DiagramFontSize 36
skinparam ClassFontName "Casual"
skinparam ClassFontSize 28
skinparam ClassAttributeIconSize 10
skinparam ClassAttributeFontName Casual
skinparam ClassAttributeFontColor #053583
skinparam ClassAttributeFontWeight normal
skinparam ClassAttributeFontSize 12
skinparam ClassMethodFontName "Casual"
skinparam ClassMethodFontSize 12
skinparam ClassMethodFontWeight 500
skinparam ClassAttributeFontStyle normal
skinparam ArrowColor #9b2c2c
skinparam PackageBorderColor #0f766e
skinparam PackageFontColor #111827
skinparam PackageFontName "Casual"
skinparam PackageBackgroundColor #ccfbf1
skinparam ClassBorderColor #0f766e
skinparam ClassBackgroundColor #ccfbf1
skinparam EnumBorderColor #b45309
skinparam EnumBackgroundColor #fef3c7
skinparam EnumFontColor #7c2d12
skinparam RectangleBorderColor #0f766e
skinparam RectangleBackgroundColor #ccfbf1
skinparam NoteBackgroundColor #fff7d6
skinparam NoteBorderColor #d4b106
skinparam ArrowFontColor #374151
skinparam ArrowFontName "Casual"

package "NuGet" {
	[OsLibCore]
	[RaiUtils]
	[JsonPit]
	[RaiImage]
	[RaiDiagram]
	[Amafu]
	[PitSeeder]
	[ImgSeeder]
	[RaidSeeder]
	[RaiGuard]
	[RaiGuard.Analyzer]
}

package "PyPI" {
	[inqaba]
	[umgodi-json]
	[vikela]
}

[JsonPit] --> [OsLibCore]
[JsonPit] --> [RaiUtils]
[RaiImage] --> [OsLibCore]
[RaiImage] --> [RaiUtils]
[RaiDiagram] --> [OsLibCore]
[RaiDiagram] --> [RaiUtils]
[RaiDiagram] --> [RaiImage]
[PitSeeder] --> [JsonPit]
[PitSeeder] --> [OsLibCore]
[ImgSeeder] --> [JsonPit]
[ImgSeeder] --> [OsLibCore]
[ImgSeeder] --> [RaiImage]
[ImgSeeder] --> [RaiUtils]
[RaidSeeder] --> [RaiDiagram]
[RaiGuard] --> [JsonPit]
[RaiGuard] --> [OsLibCore]
[RaiGuard] --> [RaiDiagram]
[RaiGuard] --> [RaiImage]
[RaiGuard] --> [RaiUtils]
[umgodi-json] --> [inqaba]

legend bottom
	Arrows point from a package to its coordinated runtime dependencies.
	RaiGuard.Analyzer ships from the RaiGuard repository as a compiler analyzer.
endlegend
@enduml
