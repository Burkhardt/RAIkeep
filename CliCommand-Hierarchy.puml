@startuml CliCommandHierarchy
' Release: 4.2.2 / CR014
skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam DiagramFontName "Casual"
skinparam DiagramFontSize 36
skinparam ClassFontName "Casual"
skinparam ClassFontSize 28
skinparam ClassAttributeIconSize 10
skinparam ClassAttributeFontName Casual
skinparam ClassAttributeFontColor #053583
skinparam ClassAttributeFontWeight normal
skinparam ClassAttributeFontSize 12
skinparam ClassMethodFontName "Casual"
skinparam ClassMethodFontSize 12
skinparam ClassMethodFontWeight 500
skinparam ClassAttributeFontStyle normal
skinparam ClassBorderColor #0f766e
skinparam ClassBackgroundColor #ccfbf1
skinparam ClassFontColor #111827
skinparam EnumBorderColor #b45309
skinparam EnumBackgroundColor #fef3c7
skinparam EnumFontColor #7c2d12
skinparam NoteBackgroundColor #fff7d6
skinparam NoteBorderColor #d4b106
skinparam ArrowColor #9b2c2c
skinparam ArrowFontColor #374151
skinparam ArrowFontName "Casual"
hide empty members

title CliCommand Hierarchy

package "OsLib" {
	abstract class CliCommand {
		+ExecutableName : string
		+PackageName : string
		+DisplayName : string
		+CandidateExecutables : IEnumerable<string>
		+IsAvailable() : bool
		+TryResolveExecutable(out executable : string) : bool
		+ResolveExecutable() : string
		+Run(arguments : string = "") : RaiSystemResult
		+Run(arguments : IEnumerable<string>) : RaiSystemResult
		+Run(arguments : IEnumerable<string>, timeoutMilliseconds : int) : RaiSystemResult
		+RunAsync(arguments : string = "", cancellationToken : CancellationToken = default) : Task<RaiSystemResult>
		+RunAsync(arguments : IEnumerable<string>, cancellationToken : CancellationToken = default) : Task<RaiSystemResult>
		+RunAsync(arguments : IEnumerable<string>, timeoutMilliseconds : int, cancellationToken : CancellationToken = default) : Task<RaiSystemResult>
		+BuildPosixShellCommand(arguments : IEnumerable<string>) : string
		+GetInstallCommand() : string
		+GetUpdateCommand() : string
	}

	class CurlCommand
	class RCloneCommand {
		+BuildArguments(subcommand : string, args : string = "") : string
		+RunSubcommand(subcommand : string, args : string = "") : RaiSystemResult
		+RunSubcommandAsync(subcommand : string, args : string = "", cancellationToken : CancellationToken = default) : Task<RaiSystemResult>
	}
	class ZipCommand
	class SevenZipCommand
	class PitsCommand {
		+BuildSeedArguments(request : PitsSeedRequest) : IReadOnlyList<string>
		+BuildExportArguments(request : PitsExportRequest) : IReadOnlyList<string>
		+BuildAuditArguments(request : PitsAuditRequest) : IReadOnlyList<string>
		+Seed(request : PitsSeedRequest) : RaiSystemResult
		+Export(request : PitsExportRequest) : RaiSystemResult
		+Audit(request : PitsAuditRequest) : RaiSystemResult
	}
	class IorgCommand {
		+BuildOrganizeArguments(request : IorgOrganizeRequest) : IReadOnlyList<string>
		+BuildCleanArguments(request : IorgCleanRequest) : IReadOnlyList<string>
		+Organize(request : IorgOrganizeRequest) : RaiSystemResult
		+Clean(request : IorgCleanRequest) : RaiSystemResult
	}
	class SshSystem {
		+ExecuteRemoteCommand(target : string, remoteCommand : string, timeoutMilliseconds : int, options : IEnumerable<string>) : RaiSystemResult
	}

	class RaiSystem {
		+Exec(out msg : string) : int
		+ExecResult(timeoutMilliseconds : int = 120000) : RaiSystemResult
		+ExecAsync(cancellationToken : CancellationToken = default) : Task<RaiSystemResult>
		+ExecAsync(timeoutMilliseconds : int, cancellationToken : CancellationToken = default) : Task<RaiSystemResult>
		+Start() : Task<ProcessResults>
	}

	class RaiSystemResult {
		+Command : string
		+Arguments : string
		+ArgumentList : IReadOnlyList<string>
		+CommandLine : string
		+StandardOutput : string
		+StandardError : string
		+Output : string
		+ExitCode : int
		+TimedOut : bool
		+Succeeded : bool
		+WorkerThreadId : int
	}
}

package "RaiImage" {
	class ImageMagickCommand {
		+BuildArguments(subcommand : string, args : string = "") : string
		+RunSubcommand(subcommand : string, args : string = "") : RaiSystemResult
		+RunSubcommandAsync(subcommand : string, args : string = "", cancellationToken : CancellationToken = default) : Task<RaiSystemResult>
	}
	class PlantUmlCommand {
		+BuildSvgArguments(pumlFileName : string, configFileName : string) : string
		+RenderSvg(pumlFileName : string, configFileName : string) : RaiSystemResult
		+RenderSvgAsync(pumlFileName : string, configFileName : string, cancellationToken : CancellationToken) : Task<RaiSystemResult>
	}
	class OptiPngCommand {
		+BuildArguments(image : RaiFile) : IReadOnlyList<string>
		+Optimize(image : RaiFile) : RaiSystemResult
	}
	class JpegTranCommand {
		+BuildArguments(options : IEnumerable<string>, source : RaiFile, destination : RaiFile) : IReadOnlyList<string>
		+Transform(options : IEnumerable<string>, source : RaiFile, destination : RaiFile) : RaiSystemResult
	}

	class ImageMagick {
		+Convert(commandline : string) : int
		+Convert(options : string, from : string, to : string) : int
		+Mogrify(commandline : string) : int
		+Composite(commandline : string) : int
		+Identify(options : string, image : string, result : string) : int
		+OptiPng(imgFileName : string) : int
		+JpegTran(imgFileName : string) : int
	}
}

CliCommand <|-- CurlCommand
CliCommand <|-- RCloneCommand
CliCommand <|-- ZipCommand
CliCommand <|-- SevenZipCommand
CliCommand <|-- PitsCommand
CliCommand <|-- IorgCommand
CliCommand <|-- ImageMagickCommand
CliCommand <|-- PlantUmlCommand
CliCommand <|-- OptiPngCommand
CliCommand <|-- JpegTranCommand
RaiSystem <|-- SshSystem

CliCommand ..> RaiSystem : creates
RaiSystem --> RaiSystemResult : returns
ImageMagick --> ImageMagickCommand : delegates to
ImageMagick --> OptiPngCommand : delegates to
ImageMagick --> JpegTranCommand : delegates to
ImageMagickCommand ..> RaiSystemResult

note right of CliCommand
	Base abstraction for local CLI tools.
	Executable resolution, availability checks,
	install/update hints, tokenized arguments,
	POSIX SSH serialization, and execution
	are centralized here.
end note

note right of RaiSystem
	ExecAsync dispatches startup off the caller
	thread and awaits process exit without blocking.
	Timeout and caller cancellation both kill the
	process tree, but remain distinct outcomes.
end note

note right of ImageMagick
	Legacy wrapper preserved as the image API.
	Process execution now flows through
	typed RaiImage command -> CliCommand -> RaiSystem.
end note

@enduml
