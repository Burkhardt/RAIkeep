				{
					"pattern": "DEFAULT_VERSION=\"\\$\\{DEFAULT_VERSION:-\\d+\\.\\d+\\.\\d+\\}\"",
					"replacement": "DEFAULT_VERSION=\"${{DEFAULT_VERSION:-{version}}}\""
				}
			]
		}
	]
}
